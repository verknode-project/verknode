# Copy to .env (gitignored); docker compose reads it for the ${...} values in
# docker-compose.yml and docker-compose.override.yml.

# published port and interface (0.0.0.0: reachable from other machines)
VERKNODE_PORT=8888
VERKNODE_BIND=127.0.0.1

# image name (e.g. to push it to a registry)
VERKNODE_IMAGE=verknode:latest

# behind Traefik (deploy/docker-compose.traefik.yml)
VERKNODE_HOST=verknode.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
